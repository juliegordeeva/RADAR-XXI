# Публичный адрес сайта без слэша в конце. Нужен для sitemap, canonical и Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend: письма с заявок. Если ключа нет, заявки пишутся в консоль сервера.
RESEND_API_KEY=
# От кого уходит письмо. Должен быть подтверждённый домен в Resend.
RESEND_FROM=RADAR XXI Kids <hello@example.com>
# Куда приходят заявки.
LEAD_TO_EMAIL=hello@example.com
